# ==========================================
# Automated Network Troubleshooting Assistant
# Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Node Environment
NODE_ENV=production

# MongoDB Database Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/network_assistant?retryWrites=true&w=majority
# (If omitted, backend automatically runs in resilient in-memory mode for demos)
MONGODB_URI=

# Allowed Frontend URL for CORS
# In production on Render, set this to your Render static site URL
FRONTEND_URL=https://network-troubleshooting-assistant.onrender.com
