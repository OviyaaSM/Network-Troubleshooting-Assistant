# ==========================================
# Automated Network Troubleshooting Assistant
# Environment Configuration
# ==========================================

# ------------------------------------------
# Backend: Render Web Service (Node.js + Express)
# ------------------------------------------
PORT=10000
NODE_ENV=production

# MongoDB Database Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/network_assistant?retryWrites=true&w=majority
# (If omitted, backend automatically runs in resilient in-memory mode for demos)
MONGODB_URI=

# Allowed Frontend URL for CORS (Vercel Frontend)
FRONTEND_URL=https://frontend-one-sandy-68.vercel.app

# ------------------------------------------
# Frontend: Vercel (React + Vite)
# ------------------------------------------
# In Vercel Project Settings -> Environment Variables:
VITE_API_URL=https://network-troubleshooting-assistant-backend.onrender.com
